# wifi-watch.service
# Generated by install.py - do not edit in place; edit the template instead.
[Unit]
Description=College WiFi captive-portal auto-login check
Documentation=https://github.com/siddhant-jain-18/college-wifi-autologin
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@PYTHON@ @LOGIN_SCRIPT@
TimeoutStartSec=180
Nice=10
SyslogIdentifier=college-wifi
