<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Generated by install.py - do not edit in place; edit the template instead.

  @LOG_FILE@ here only receives output written before the login script sets
  up its own rotating log; the script writes the real log to its data dir.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.college-wifi-autologin.watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>@PYTHON@</string>
        <string>@LOGIN_SCRIPT@</string>
    </array>

    <!-- Run every 5 minutes -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Also run once at load / login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Never start two copies back to back -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>@LOG_FILE@</string>
    <key>StandardErrorPath</key>
    <string>@LOG_FILE@</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>

    <!-- Let the browser finish even if the agent is torn down. -->
    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
