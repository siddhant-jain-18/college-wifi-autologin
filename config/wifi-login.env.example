# wifi-login.env.example
#
# Template for the credentials file. install.py copies this to the
# platform-appropriate config location and lets you fill in the values
# interactively. To set up manually:
#
#   Linux:   ~/.config/college-wifi-autologin/wifi-login.env
#   macOS:   ~/Library/Application Support/college-wifi-autologin/wifi-login.env
#   Windows: %LOCALAPPDATA%\college-wifi-autologin\wifi-login.env
#
# File permissions should be 0600 (chmod 600 on Unix). install.py enforces this.
#
# Format: shell-style `export KEY=value` lines. The login script parses them
# itself, so no shell is involved — but keeping the `export` prefix means you
# can also `source` this file from a shell for debugging.
#
# Quoting: use single quotes around values. Passwords often contain
# characters ($, `, !, \) that bash would otherwise mangle. Single quotes
# disable all interpretation.

# --- Required ---------------------------------------------------------------
export COLLEGE_WIFI_USER=''
export COLLEGE_WIFI_PASS=''

# --- Optional overrides (uncomment and edit only if needed) -----------------

# Portal login page. Default is a Cisco ISE captive portal.
# export COLLEGE_WIFI_PORTAL_URL='https://172.22.2.6/connect/PortalMain'

# Run the browser visibly. Useful for debugging what the portal is doing.
# Default: headless.
# export WIFI_LOGIN_HEADLESS='0'

# Per-step timeout in seconds. Raise if the portal is slow.
# Default: 30
# export WIFI_LOGIN_TIMEOUT='30'

# Where screenshots go on failure.
# Default: <data dir>/screenshots (see the header comment for the OS path)
# export WIFI_LOGIN_SCREENSHOT_DIR='/custom/path'

# Where the log file goes.
# Default: <data dir>/logs/login.log
# export WIFI_LOGIN_LOG_FILE='/custom/path/login.log'

# Where the concurrency lock lives.
# Default: <data dir>/login.lock
# export WIFI_LOGIN_LOCK_FILE='/custom/path/login.lock'