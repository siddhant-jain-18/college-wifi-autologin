# wifi-login.env.example
#
# Template for ~/.config/wifi-login.env
#
# Copy this file to ~/.config/wifi-login.env and fill in your credentials:
#
#     mkdir -p ~/.config
#     cp config/wifi-login.env.example ~/.config/wifi-login.env
#     chmod 600 ~/.config/wifi-login.env
#     $EDITOR ~/.config/wifi-login.env
#
# install.sh does this for you interactively; you only need to copy
# manually if you're setting things up by hand.
#
# Format: bash `export` lines. The wrapper sources this file with `set -a`
# so `export` is technically optional, but including it means you can also
# `source ~/.config/wifi-login.env` from an interactive shell to debug.
#
# Quoting: use SINGLE quotes around values. Passwords often contain
# characters that bash would otherwise interpret ( $ ` ! & \ ). Single
# quotes disable all interpretation. If your password contains a literal
# single quote ('), write it as:  '\''
#
# Permissions: chmod 600. The wrapper will warn if the file is readable
# by other users, but it won't fail — fix it yourself.

# Your college WiFi username (roll number, email, or whatever the portal asks for).
export COLLEGE_WIFI_USER=''

# Your college WiFi password. Leave the single quotes; put the password between them.
export COLLEGE_WIFI_PASS=''

# ---------------------------------------------------------------------------
# Optional overrides. Uncomment and edit only if the defaults don't fit.
# ---------------------------------------------------------------------------

# Portal login page. Change this if your college uses a different IP/hostname.
# Default in the python script: https://172.22.2.6/connect/PortalMain
# export COLLEGE_WIFI_PORTAL_URL='https://172.22.2.6/connect/PortalMain'

# Run the browser visibly instead of headless. Useful for debugging:
# you'll see exactly what the portal is doing. Remember to set it back.
# Default: 1 (headless)
# export WIFI_LOGIN_HEADLESS='0'

# Per-step timeout in seconds. Raise if the portal is slow.
# Default: 30
# export WIFI_LOGIN_TIMEOUT='30'

# Where screenshots go on failure. Default:
#   ${XDG_STATE_HOME:-~/.local/state}/college-wifi/screenshots
# export WIFI_LOGIN_SCREENSHOTS="$HOME/Pictures/college-wifi"