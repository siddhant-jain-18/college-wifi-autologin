# wifi-login.env.example
#
# Template for the credentials file.  install.py writes the two required
# values for you; everything below them is optional.  To set up manually,
# copy this file to the platform path:
#
#   Linux:   ~/.config/college-wifi-autologin/wifi-login.env
#   macOS:   ~/Library/Application Support/college-wifi-autologin/wifi-login.env
#   Windows: %LOCALAPPDATA%\college-wifi-autologin\wifi-login.env
#
# File permissions should be 0600 (chmod 600 on Unix); install.py enforces it.
#
# Format: shell-style `export KEY=value` lines.  The scripts parse the file
# themselves, so no shell is involved — but keeping the `export` prefix means
# you can also `source` it from a shell while debugging.
#
# Quoting: use single quotes around values.  A password containing a single
# quote is written 'like'\''this'.  Everything inside single quotes is taken
# literally, so $, `, ! and \ need no escaping.
#
# Precedence: command-line flags > environment variables > this file > defaults.
# Every variable below can also be exported in the environment instead.

# --- Required ---------------------------------------------------------------
export COLLEGE_WIFI_USER=''
export COLLEGE_WIFI_PASS=''

# --- Portal -----------------------------------------------------------------
# The page that asks for your username.  Default is a Cisco ISE portal.
# export COLLEGE_WIFI_PORTAL_URL='https://172.22.2.6/connect/PortalMain'

# Use a different credentials file (useful for testing / multiple accounts).
# export COLLEGE_WIFI_CONFIG_FILE='/path/to/other.env'

# --- Browser ----------------------------------------------------------------
# Run the browser visibly.  Useful for debugging what the portal is doing.
# Default: headless (1).
# export WIFI_LOGIN_HEADLESS='0'

# Block images, fonts and media while loading the portal.  Faster and lighter;
# set to 0 only if a portal needs them to render its form.
# export WIFI_LOGIN_BLOCK_RESOURCES='1'

# Force the --no-sandbox Chromium flag from the very first launch.  Normally
# the script only falls back to it if a normal launch fails.  Default: unset.
# export WIFI_LOGIN_NO_SANDBOX='1'

# --- Timing -----------------------------------------------------------------
# Per-step timeout in seconds.  Raise it if the portal is slow.
# export WIFI_LOGIN_TIMEOUT='30'

# How many attempts per run, and how long to wait between them.
# export WIFI_LOGIN_ATTEMPTS='3'
# export WIFI_LOGIN_BACKOFF='5'

# How long to wait for the post-login page after submitting.
# export WIFI_LOGIN_POST_SUBMIT='25'

# How long to wait for the portal's cpRSAobj to become encrypt-ready.
# Set to 0 for portals that do not use client-side RSA encryption.
# export WIFI_LOGIN_RSA_TIMEOUT='15'

# Timeout for each "do we have internet?" probe.
# export WIFI_LOGIN_CONNECTIVITY_TIMEOUT='5'

# --- Portal selectors (for non-Cisco-ISE portals) ---------------------------
# These are tried BEFORE the built-in selectors.  Separate several selectors
# with commas or newlines.
#
#   # export WIFI_LOGIN_USER_SELECTOR='#LoginUserPassword_auth_username'
#   # export WIFI_LOGIN_PASSWORD_SELECTOR='#LoginUserPassword_auth_password'
#   # export WIFI_LOGIN_SUBMIT_SELECTOR='button:has-text("Sign In")'

# --- Files ------------------------------------------------------------------
# Default screenshots go to <data dir>/screenshots.
# export WIFI_LOGIN_SCREENSHOT_DIR='/custom/path'

# Default: <data dir>/logs/login.log  (rotated at 1 MB, one backup kept)
# export WIFI_LOGIN_LOG_FILE='/custom/path/login.log'

# Default: <data dir>/login.lock
# export WIFI_LOGIN_LOCK_FILE='/custom/path/login.lock'
